 "rules": [
  {
   "id": "AREA_PER_SEAT",
   "title": "Built-up area per seat",
   "inputs": [
    "intake.total",
    "area.built_up_sqm"
   ],
   "params": {
    "min_sqm_per_seat": 4.0
   },
   "severity": "high",
   "required_rung": 2,
   "clause": {
    "doc": "APH 2024-27",
    "ref": "TBD",
    "page": null
   },
   "message": "Built-up area per seat is {value:.1f} sq m; configured norm is {min_sqm_per_seat} (illustrative).",
   "value": {
    "t": "bin",
    "op": "/",
    "l": {
     "t": "ref",
     "p": "area.built_up_sqm"
    },
    "r": {
     "t": "ref",
     "p": "intake.total"
    }
   },
   "expr": {
    "t": "cmp",
    "op": ">=",
    "l": {
     "t": "ref",
     "p": "value"
    },
    "r": {
     "t": "ref",
     "p": "params.min_sqm_per_seat"
    }
   }
  },
  {
